{
    "id": "helm.term",
    "name": "Terminal",
    "version": "0.1.0",
    "description": "Tabs, splits and profiles over bro's native <terminal> element",
    "icon": "assets/icon.svg",
    "categories": ["System", "TerminalEmulator"],
    "keywords": ["terminal", "shell", "console", "command line", "prompt", "term"],
    "singleInstance": true,
    "permissions": ["spawn", "files"],
    "actions": [
        { "id": "new-window", "name": "New Window", "args": ["--new-window"] }
    ],
    "app": ".",
    "width": 1100,
    "height": 700,
    "minWidth": 420,
    "minHeight": 260,
    "resizable": true,
    "splash": false,
    "watch": false
}
